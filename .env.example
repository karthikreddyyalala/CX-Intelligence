# ─── CX Intelligence — environment variables ───────────────
# Copy this file to ".env" and fill in real values.
# The real ".env" is git-ignored and must NEVER be committed.

# Apify API token — powers the review scrapers (Google Maps, Trustpilot, etc.)
# Get one at: https://console.apify.com/account/integrations
APIFY_TOKEN=your_apify_token_here

# Anthropic API key — powers the AI analysis (sentiment, themes, identity matching)
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_key_here

# Port the backend server listens on (default 3001)
PORT=3001
