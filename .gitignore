# ─── Secrets — NEVER commit ────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ─── Databases & their sidecar/backup files ────────────────
# Ship ONLY the demo database (private repo) so the live site has data.
# Everything else — WAL/SHM sidecars, dated backups, stray DBs — stays out.
# NOTE: plain "*.db" misses SQLite's WAL/SHM and dated backups, so each
# variant is listed explicitly.
*.db
!backend/data/cx_dashboard.db
*.db-wal
*.db-shm
*.db.bak-*
*.bak-*
*.sqlite
*.sqlite3

# ─── Dependencies & build output ───────────────────────────
node_modules/
dist/
build/
.vite/

# ─── Generated / scratch ───────────────────────────────────
reviews-output.json
history/
*.log

# ─── OS / editor cruft ─────────────────────────────────────
.DS_Store
.idea/
*.swp
